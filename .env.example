# Copy to .env if you want to override anything; every value below is optional and has a safe default.
FOUNDRATE_HOME=var                 # state dir: offline DuckDB, online SQLite, model registry, logs
FOUNDRATE_MODEL_NAME=foundrate
FOUNDRATE_N_STORES=12
FOUNDRATE_N_ITEMS=80
FOUNDRATE_LINES_PER_DAY=800
FOUNDRATE_SEED=7
FOUNDRATE_TRAIN_SNAPSHOTS=8
FOUNDRATE_PSI_THRESHOLD=0.2
FOUNDRATE_STORE_PSI_THRESHOLD=0.5
FOUNDRATE_AUC_DROP_THRESHOLD=0.05
FOUNDRATE_MONITOR_WINDOW=2000
FOUNDRATE_MONITOR_MIN_SAMPLES=500
# docker-compose only (local demo credentials, not secrets)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
